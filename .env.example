# Supabase Configuration
# Get these from your Supabase project: Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OAuth Providers (Optional - for future integration)
# Solo gli ID pubblici. I client secret NON vanno qui: le variabili VITE_* finiscono
# nel bundle del browser. Lo scambio OAuth va fatto lato server.
VITE_META_APP_ID=
VITE_GOOGLE_CLIENT_ID=

# App Configuration
VITE_APP_NAME=BI Dashboard Cucine Retail
VITE_APP_URL=https://otre25.github.io/BI-dashboard-retail
